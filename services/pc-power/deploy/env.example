# Configuración de pc-power. Se copia a /etc/raspberryon/pc-power.env solo si no existe.
# Hasta rellenar las tres primeras líneas el servicio se niega a arrancar (es lo esperado).

# Código de acceso (mínimo 8 caracteres; se recomiendan 12 o más). Cambiarlo cierra todas las sesiones.
ACCESS_CODE=
# IP local del PC al que se hace ping (reserva DHCP o IP fija)
PC_HOST=
# Polaridad del módulo de relé: true (activo en alto) o false (activo en bajo). Ver README.
RELAY_ACTIVE_HIGH=

# --- Opcionales (valores por defecto) ---
#PC_NAME=PC
#RELAY_GPIO=23
#SHORT_PULSE_MS=500
#LONG_PULSE_MS=6000
#PING_INTERVAL_S=3
#TRANSITION_TIMEOUT_S=120
#SESSION_DAYS=30
#COOKIE_PATH=/pc/
#RELAY_DRIVER=gpio
PORT=@PORT@

# --- Notificaciones push por ntfy (opcional) ---
# URL con el tema: https://ntfy.sh/<tema-largo-y-aleatorio>. Sin NTFY_URL no hay avisos.
# En ntfy.sh público el nombre del tema actúa como contraseña: usa 20+ caracteres aleatorios,
# o un tema con control de acceso y su token en NTFY_TOKEN, o un servidor ntfy propio.
#NTFY_URL=
#NTFY_TOKEN=

# --- Programación y apariencia (opcional) ---
# Zona horaria para interpretar y mostrar las horas programadas (no depende de la zona del sistema).
#TZ=America/Bogota
# Minutos que espera el apagado programado antes de forzar el apagado si el PC sigue encendido.
#OFF_FORCE_AFTER_MIN=10
# Nombre neutro al añadir el panel a la pantalla de inicio del móvil.
#APP_NAME=Panel

# --- Recordatorio de apagado (requiere NTFY_URL) ---
# Los botones Apagar / Mantener encendido solo aparecen con PUBLIC_URL (solo esquema y host) y
# necesitan un certificado válido (dominio + Let's Encrypt). Sin PUBLIC_URL el aviso va sin botones.
#PUBLIC_URL=https://mi-dominio.duckdns.org
# Horas encendido hasta el primer aviso, y horas fijas de los siguientes (en TZ).
#REMINDER_AFTER_H=4
#REMINDER_TIMES=21:00,06:00
